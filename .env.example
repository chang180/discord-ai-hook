DISCORD_WEBHOOK_URL=
CRON_SCHEDULE=0 20 * * *
TZ=Asia/Taipei
DRY_RUN=false
MAX_NOTIFICATIONS_PER_SOURCE=3
# MAX_NOTIFICATIONS_PER_RUN=3
PORT=3000
HOST=127.0.0.1
ENABLE_TEST_UI=true
DATABASE_PATH=./data/watcher.db
# 定時任務刪除幾天前的 SQLite 文章紀錄（與下方「查詢窗口」無關）
ARTICLE_RETENTION_DAYS=30
# 發布日窗口（依 TZ 日曆日，不含「今天」）：連續 N 個「已過去」的日期
# 1 = 僅昨天（例：台北 5/24 20:00 跑 → 只抓 5/23 發布）；7 = 昨天起算共 7 天；0 = 不限制
ARTICLE_LOOKBACK_DAYS=1
HTTP_USER_AGENT=Mozilla/5.0 (compatible; DiscordAILabsWatcher/1.0)
